# Local runtime identity. Production requires DATABASE_URL and fails closed without it.
APP_ENV=development
# Set DATABASE_URL only in the local process environment or a secret manager.
# DATABASE_URL=postgresql://shopee_app:<url-encoded-password>@127.0.0.1:5432/ShopeeManagement

# Each process binds independently.
WEB_HOST=127.0.0.1
WEB_PORT=3000
WORKER_HOST=127.0.0.1
WORKER_PORT=3001

# Enable only after every value below is configured. Generate each secret with:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
SHOPEE_LIVE_OAUTH_ENABLED=false
INLINE_WORKER_ENABLED=false
INLINE_WORKER_INTERVAL_MS=30000
# PUBLIC_BASE_URL=https://dashboard.example.com
# INTERNAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
# INTERNAL_AUTH_SUBJECT=owner@example.com
# INTERNAL_LOGIN_TOKEN=<32-byte-base64url>
# WEB_SESSION_SECRET=<different-32-byte-base64url>
# SHOPEE_PARTNER_ID=<live-partner-id>
# SHOPEE_PARTNER_APPLICATION_ID=00000000-0000-4000-8000-000000000000
# WORKER_CREDENTIAL_ENCRYPTION_KEY=<32-byte-base64url>
# CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# OAUTH_STATE_LIFETIME_SECONDS=600

# Worker-only Shopee credentials are supplied by the platform secret manager.
# Do not put partner keys, OAuth codes, access tokens, refresh tokens, or auth
# headers in this file. Never expose them through web responses, logs, traces,
# metrics, or client bundles.
