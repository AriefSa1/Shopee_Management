{
  "name": "shopee-multi-store-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types apps/web/src/main.ts",
    "web:dev": "node --env-file-if-exists=.env --experimental-strip-types --watch apps/web/src/main.ts",
    "web:start": "node --env-file-if-exists=.env --experimental-strip-types apps/web/src/main.ts",
    "worker:dev": "node --env-file-if-exists=.env --experimental-strip-types --watch apps/worker/src/main.ts",
    "worker:start": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/main.ts",
    "worker:once": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/once-main.ts",
    "worker:encryption-preflight": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/credential-encryption-preflight-main.ts",
    "test": "node --experimental-strip-types --test apps/web/src/app.test.ts apps/worker/src/app.test.ts packages/config/src/runtime-config.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p apps/dashboard/tsconfig.json",
    "lint": "biome check .",
    "ui:dev": "vite",
    "build:ui": "vite build",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "build": "vite build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.9.8",
    "pg": "^8.23.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@mantine/charts": "^9.6.2",
    "@mantine/core": "^9.6.2",
    "@mantine/dates": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
